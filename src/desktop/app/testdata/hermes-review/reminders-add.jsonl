{"id":"fixture-reminders-add","messages":[{"role":"user","content":"Add a reminder for Sample follow-up."},{"role":"assistant","content":"I’ll add it in Reminders."},{"role":"assistant","content":"","tool_calls":[{"function":{"name":"terminal","arguments":"{\"command\":\"desktopctl app open Reminders --wait --json\"}"}}]},{"role":"tool","tool_name":"terminal","content":"{\"ok\":true,\"result\":{\"window_id\":\"reminders_fixture\"}}"},{"role":"assistant","content":"","tool_calls":[{"function":{"name":"terminal","arguments":"{\"command\":\"desktopctl keyboard press cmd+n --active-window reminders_fixture\"}"}}]},{"role":"tool","tool_name":"terminal","content":"New reminder editor is available"},{"role":"assistant","content":"","tool_calls":[{"function":{"name":"terminal","arguments":"{\"command\":\"desktopctl keyboard type Sample follow-up --active-window reminders_fixture\"}"}}]},{"role":"tool","tool_name":"terminal","content":"Typed reminder text"},{"role":"assistant","content":"","tool_calls":[{"function":{"name":"terminal","arguments":"{\"command\":\"desktopctl keyboard press enter --active-window reminders_fixture\"}"}}]},{"role":"tool","tool_name":"terminal","content":"Reminder appears in the list"},{"role":"assistant","content":"The reminder is visible in Reminders."}]}
